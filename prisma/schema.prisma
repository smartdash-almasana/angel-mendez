generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subscriber {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  whatsapp  String
  startDate DateTime @default(now())
  endDate   DateTime?
  status    String   // 'active' o 'inactive'
}

model Settings {
  id               String @id @default("global_config")
  aliasMercadoPago String
}
